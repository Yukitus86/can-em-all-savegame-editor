<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CanEmAllEditor.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CanEmAllEditor/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://CanEmAllEditor/Themes/Flags.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://CanEmAllEditor/Themes/Dark.axaml" />
    </Application.Styles>
</Application>
